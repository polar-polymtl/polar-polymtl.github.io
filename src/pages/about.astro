---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PartnerLogos from '../components/PartnerLogos.astro';
import { useTranslations, type Lang } from '../i18n/ui';

const { lang = 'en' } = Astro.props as { lang?: Lang };
const t = useTranslations(lang);

const conditions =
  lang === 'fr'
    ? ['AVC', 'Lésion médullaire', 'Paralysie cérébrale', 'Sclérose en plaques', 'Dystrophie musculaire', 'SLA', 'Amyotrophie spinale', 'Autres atteintes motrices']
    : ['Stroke', 'Spinal cord injury', 'Cerebral palsy', 'Multiple sclerosis', 'Muscular dystrophy', 'ALS', 'Spinal muscular atrophy', 'Other motor disabilities'];

const values = [
  { title: t('about.value.relearn.title'), body: t('about.value.relearn.body') },
  { title: t('about.value.restore.title'), body: t('about.value.restore.body') },
  { title: t('about.value.augment.title'), body: t('about.value.augment.body') },
];
---

<BaseLayout lang={lang} title={t('about.eyebrow')} description={t('about.lead')}>
  <PageHero eyebrow={t('about.eyebrow')} title={t('about.title')} lead={t('about.lead')} />

  <!-- Mission -->
  <section class="section">
    <div class="container mission-grid">
      <div class="reveal">
        <img class="about-logo" src="/images/polar-logo-full.webp" alt="POLAR — Polytechnique Lab for Assistive and Rehabilitation Technologies" width="720" height="748" loading="lazy" decoding="async" />
        <span class="eyebrow">{t('about.mission.eyebrow')}</span>
        <h2>{t('about.mission.title')}</h2>
        <p class="lead">{t('about.mission.lead')}</p>
        <p>{t('about.mission.body')}</p>
      </div>
      <div class="values reveal">
        {values.map((v, i) => (
          <div class="value">
            <span class="value__num">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{v.title}</h3>
              <p>{v.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Banner -->
  <section class="banner-section">
    <div class="container">
      <figure class="banner reveal">
        <img src="/images/gait-banner.webp" alt="POLAR" loading="lazy" decoding="async" width="1600" height="578" />
      </figure>
    </div>
  </section>

  <!-- Living Lab -->
  <section class="section section--tint">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">{t('about.living.eyebrow')}</span>
        <h2>{t('about.living.title')}</h2>
        <p>{t('about.living.body')}</p>
      </div>
    </div>
  </section>

  <!-- Who we serve -->
  <section class="section">
    <div class="container serve-grid">
      <div class="reveal">
        <span class="eyebrow">{t('about.serve.eyebrow')}</span>
        <h2>{t('about.serve.title')}</h2>
        <p class="muted">{t('about.serve.body')}</p>
      </div>
      <ul class="condition-list reveal">
        {conditions.map((c) => <li>{c}</li>)}
      </ul>
    </div>
  </section>

  <!-- Partners -->
  <section class="section section--soft">
    <div class="container">
      <div class="section-head section-head--center reveal">
        <span class="eyebrow">{t('about.partners.eyebrow')}</span>
        <h2>{t('about.partners.title')}</h2>
        <p>{t('about.partners.body')}</p>
      </div>
      <PartnerLogos />
    </div>
  </section>

  <!-- Contact -->
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">{t('about.contact.eyebrow')}</span>
        <h2>{t('about.contact.title')}</h2>
      </div>
      <div class="contact-grid">
        <div class="contact-card card reveal">
          <h3>{t('about.contact.general')}</h3>
          <p><a href="mailto:POLAR@polymtl.ca">POLAR@polymtl.ca</a></p>
          <p><a href="tel:+15143404711,3939">(514) 340-4711 ext. 3939</a></p>
        </div>
        <div class="contact-card card reveal">
          <h3>{t('about.contact.opps')}</h3>
          <p>{t('about.contact.opps.body')}</p>
          <p><a href="mailto:abolfazl.mohebbi@polymtl.ca">abolfazl.mohebbi@polymtl.ca</a></p>
        </div>
        <div class="contact-card card reveal">
          <h3>{t('about.contact.find')}</h3>
          <address>
            <strong>Polytechnique Montréal</strong><br />
            Pavillon principal, A630.5<br />
            2900 Édouard-Montpetit Blvd<br />
            Montréal, QC, Canada
          </address>
          <address>
            <strong>CHU Sainte-Justine</strong><br />
            Technopole en réadaptation pédiatrique
          </address>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-logo { width: 170px; height: auto; margin-bottom: 1.4rem; }

  .banner-section { padding-block: clamp(1rem, 2vw, 2rem); }
  .banner { margin: 0; text-align: center; }
  .banner img { width: 100%; max-width: 450px; height: auto; margin-inline: auto; }

  .mission-grid, .serve-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.75rem, 4vw, 3.5rem);
    align-items: start;
  }
  .values { display: flex; flex-direction: column; gap: 1rem; }
  .value {
    display: flex; gap: 1rem; align-items: flex-start;
    padding: 1.3rem 1.4rem;
    background: var(--bg-soft);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .value__num { font-family: var(--font-head); font-weight: 700; color: var(--brand-400); font-size: 1.1rem; }
  .value h3 { margin: 0 0 0.25rem; font-size: 1.15rem; }
  .value p { margin: 0; color: var(--muted); font-size: 0.95rem; }

  .condition-list {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: 1fr 1fr; gap: 0.7rem;
  }
  .condition-list li {
    padding: 0.8rem 1rem;
    background: var(--bg);
    border: 1px solid var(--line);
    border-left: 3px solid var(--brand-400);
    border-radius: 8px;
    font-family: var(--font-head);
    font-weight: 500;
    font-size: 0.95rem;
  }

  .contact-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1.25rem, 3vw, 2rem); }
  .contact-card { padding: 1.7rem; }
  .contact-card h3 { margin: 0 0 0.8rem; font-size: 1.1rem; }
  .contact-card p { margin: 0 0 0.5rem; }
  .contact-card address { font-style: normal; color: var(--ink-soft); line-height: 1.7; margin-bottom: 1rem; }
  .contact-card address:last-child { margin-bottom: 0; }

  @media (max-width: 820px) {
    .mission-grid, .serve-grid { grid-template-columns: 1fr; }
    .contact-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 480px) {
    .condition-list { grid-template-columns: 1fr; }
  }
</style>
