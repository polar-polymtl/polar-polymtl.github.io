---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PartnerLogos from '../components/PartnerLogos.astro';

const conditions = [
  'Stroke',
  'Spinal cord injury',
  'Cerebral palsy',
  'Multiple sclerosis',
  'Muscular dystrophy',
  'ALS',
  'Spinal muscular atrophy',
  'Other motor disabilities',
];

const values = [
  {
    title: 'Relearn',
    body: 'Retraining movement and neuromotor control through robotic and interactive therapy.',
  },
  {
    title: 'Restore',
    body: 'Recovering lost function with rehabilitation robots, prosthetics, and biomechatronics.',
  },
  {
    title: 'Augment',
    body: 'Extending human ability and independence with wearable and assistive technologies.',
  },
];
---

<BaseLayout title="About" description="About POLAR — mission, the Living Lab approach, partners, and how to reach the lab at Polytechnique Montréal.">
  <PageHero
    eyebrow="About"
    title="Restoring movement through human-centred engineering."
    lead="POLAR — the Polytechnique Lab for Assistive and Rehabilitation Technologies — develops robotics and biomechatronics that help people relearn, restore, and augment their neuromotor performance."
  />

  <!-- Mission -->
  <section class="section">
    <div class="container mission-grid">
      <div class="reveal">
        <img class="about-logo" src="/images/polar-logo-full.webp" alt="POLAR — Polytechnique Lab for Assistive and Rehabilitation Technologies" width="720" height="748" loading="lazy" decoding="async" />
        <span class="eyebrow">Our mission</span>
        <h2>Technology in the service of mobility.</h2>
        <p class="lead">
          At POLAR, we research and develop innovative robotics and biomechatronics to help humans
          relearn, restore, or augment their neuromotor performance — spanning rehabilitation
          robotics, assistive technologies, and interventions that support people with disabilities
          in everyday life.
        </p>
        <p>
          Our work reaches across the lifespan, from children to older adults, and is grounded in
          close collaboration with clinicians and the people who use our technologies.
        </p>
      </div>
      <div class="values reveal">
        {values.map((v, i) => (
          <div class="value">
            <span class="value__num">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{v.title}</h3>
              <p>{v.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Banner -->
  <section class="banner-section">
    <div class="container">
      <figure class="banner reveal">
        <img src="/images/gait-banner.webp" alt="From assisted walking to independent gait — restoring human mobility" loading="lazy" decoding="async" width="1600" height="578" />
      </figure>
    </div>
  </section>

  <!-- Living Lab -->
  <section class="section section--tint">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">The Living Lab approach</span>
        <h2>Patients and clinicians at the heart of the process.</h2>
        <p>
          We place the people we serve — and the health professionals who care for them — at the
          centre of innovation. By co-designing and testing in real clinical and everyday settings,
          our technologies stay grounded in genuine needs.
        </p>
      </div>
    </div>
  </section>

  <!-- Who we serve -->
  <section class="section">
    <div class="container serve-grid">
      <div class="reveal">
        <span class="eyebrow">Who we serve</span>
        <h2>Supporting people across many conditions.</h2>
        <p class="muted">
          Our research aims to improve mobility and independence for patients of all ages living with
          a range of motor conditions, including:
        </p>
      </div>
      <ul class="condition-list reveal">
        {conditions.map((c) => <li>{c}</li>)}
      </ul>
    </div>
  </section>

  <!-- Partners -->
  <section class="section section--soft">
    <div class="container">
      <div class="section-head section-head--center reveal">
        <span class="eyebrow">Partners &amp; support</span>
        <h2>Where research meets care.</h2>
        <p>POLAR is supported by leading academic and clinical institutions across Montréal.</p>
      </div>
      <PartnerLogos />
    </div>
  </section>

  <!-- Contact -->
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Contact</span>
        <h2>Get in touch.</h2>
      </div>
      <div class="contact-grid">
        <div class="contact-card card reveal">
          <h3>General inquiries</h3>
          <p><a href="mailto:POLAR@polymtl.ca">POLAR@polymtl.ca</a></p>
          <p><a href="tel:+15143404711,3939">(514) 340-4711 ext. 3939</a></p>
        </div>
        <div class="contact-card card reveal">
          <h3>Opportunities</h3>
          <p>Prospective students &amp; collaborators:</p>
          <p><a href="mailto:abolfazl.mohebbi@polymtl.ca">abolfazl.mohebbi@polymtl.ca</a></p>
        </div>
        <div class="contact-card card reveal">
          <h3>Find us</h3>
          <address>
            <strong>Polytechnique Montréal</strong><br />
            Pavillon principal, A630.5<br />
            2900 Édouard-Montpetit Blvd<br />
            Montréal, QC, Canada
          </address>
          <address>
            <strong>CHU Sainte-Justine</strong><br />
            Technopole en réadaptation pédiatrique
          </address>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-logo { width: 170px; height: auto; margin-bottom: 1.4rem; }

  .banner-section { padding-block: clamp(1rem, 2vw, 2rem); }
  .banner { margin: 0; text-align: center; }
  .banner img { width: 100%; max-width: 450px; height: auto; margin-inline: auto; }

  .mission-grid, .serve-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.75rem, 4vw, 3.5rem);
    align-items: start;
  }
  .values { display: flex; flex-direction: column; gap: 1rem; }
  .value {
    display: flex; gap: 1rem; align-items: flex-start;
    padding: 1.3rem 1.4rem;
    background: var(--bg-soft);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .value__num { font-family: var(--font-head); font-weight: 700; color: var(--brand-400); font-size: 1.1rem; }
  .value h3 { margin: 0 0 0.25rem; font-size: 1.15rem; }
  .value p { margin: 0; color: var(--muted); font-size: 0.95rem; }

  .condition-list {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: 1fr 1fr; gap: 0.7rem;
  }
  .condition-list li {
    padding: 0.8rem 1rem;
    background: var(--bg);
    border: 1px solid var(--line);
    border-left: 3px solid var(--brand-400);
    border-radius: 8px;
    font-family: var(--font-head);
    font-weight: 500;
    font-size: 0.95rem;
  }

  .contact-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1.25rem, 3vw, 2rem); }
  .contact-card { padding: 1.7rem; }
  .contact-card h3 { margin: 0 0 0.8rem; font-size: 1.1rem; }
  .contact-card p { margin: 0 0 0.5rem; }
  .contact-card address { font-style: normal; color: var(--ink-soft); line-height: 1.7; margin-bottom: 1rem; }
  .contact-card address:last-child { margin-bottom: 0; }

  @media (max-width: 820px) {
    .mission-grid, .serve-grid { grid-template-columns: 1fr; }
    .contact-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 480px) {
    .condition-list { grid-template-columns: 1fr; }
  }
</style>
