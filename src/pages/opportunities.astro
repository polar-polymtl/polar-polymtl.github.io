---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import experimentsData from '../data/experiments.json';
import { useTranslations, type Lang } from '../i18n/ui';
import { localizeExperiment } from '../i18n/content';

const { lang = 'en' } = Astro.props as { lang?: Lang };
const t = useTranslations(lang);

const positions = [
  { title: t('opps.pos.grad.title'), body: t('opps.pos.grad.body'), tag: t('opps.pos.grad.tag') },
  { title: t('opps.pos.postdoc.title'), body: t('opps.pos.postdoc.body'), tag: t('opps.pos.postdoc.tag') },
  { title: t('opps.pos.undergrad.title'), body: t('opps.pos.undergrad.body'), tag: t('opps.pos.undergrad.tag') },
];
const looking = [t('opps.value.1'), t('opps.value.2'), t('opps.value.3'), t('opps.value.4')];
const experiments = experimentsData.map((e) => localizeExperiment(e, lang));
---

<BaseLayout lang={lang} title={t('opps.eyebrow')} description={t('opps.lead')}>
  <PageHero eyebrow={t('opps.eyebrow')} title={t('opps.title')} lead={t('opps.lead')}>
    <div class="hero-actions">
      <a href="#apply" class="btn">{t('opps.apply.cta')}</a>
      <a href="#experiments" class="btn btn--ghost">{t('opps.exp.cta')}</a>
    </div>
  </PageHero>

  <!-- Positions -->
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">{t('opps.who.eyebrow')}</span>
        <h2>{t('opps.who.title')}</h2>
      </div>
      <div class="grid grid--3">
        {positions.map((p) => (
          <article class="pos card reveal">
            <span class="tag">{p.tag}</span>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- What we look for + How to apply -->
  <section class="section section--soft">
    <div class="container apply-grid" id="apply">
      <div class="reveal">
        <span class="eyebrow">{t('opps.value.eyebrow')}</span>
        <h2>{t('opps.value.title')}</h2>
        <ul class="check-list">
          {looking.map((item) => (
            <li>
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>
        <p class="muted">{t('opps.value.note')}</p>
      </div>

      <aside class="apply-card card reveal">
        <h3>{t('opps.apply.title')}</h3>
        <p>{t('opps.apply.intro')}</p>
        <ol class="apply-steps">
          <li>{t('opps.apply.step1')}</li>
          <li>{t('opps.apply.step2')}</li>
          <li>{t('opps.apply.step3')}</li>
        </ol>
        <a href="mailto:abolfazl.mohebbi@polymtl.ca?subject=Prospective%20student%20%E2%80%94%20POLAR%20Lab" class="btn apply-btn">
          {t('opps.apply.email')}
        </a>
        <p class="apply-email">abolfazl.mohebbi@polymtl.ca</p>
      </aside>
    </div>
  </section>

  <!-- Participate in Experiments -->
  <section class="section" id="experiments">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">{t('opps.exp.eyebrow')}</span>
        <h2>{t('opps.exp.title')}</h2>
        <p>{t('opps.exp.lead')}</p>
      </div>
      <div class="grid grid--2">
        {experiments.map((e) => (
          <article class="exp card reveal">
            <h3 class="exp__title">{e.title}</h3>
            <p class="exp__desc">{e.description}</p>
            <dl class="exp__meta">
              <div><dt>{t('opps.exp.duration')}</dt><dd>{e.duration}</dd></div>
              <div><dt>{t('opps.exp.location')}</dt><dd>{e.location}</dd></div>
              <div><dt>{t('opps.exp.compensation')}</dt><dd>{e.compensation}</dd></div>
            </dl>
            <a class="btn btn--ghost exp__cta" href={`mailto:${e.contact}?subject=${encodeURIComponent('Participation — ' + e.title)}`}>
              {t('opps.exp.contact')}
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 1.6rem; }

  .exp { padding: 1.8rem; display: flex; flex-direction: column; gap: 1rem; }
  .exp__title { margin: 0; font-size: 1.2rem; }
  .exp__desc { margin: 0; color: var(--muted); font-size: 0.96rem; line-height: 1.6; flex: 1; }
  .exp__meta { display: flex; flex-wrap: wrap; gap: 0.75rem 1.75rem; margin: 0; padding: 0.9rem 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .exp__meta dt { font-family: var(--font-head); font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .exp__meta dd { margin: 0.15rem 0 0; font-weight: 600; font-size: 0.92rem; }
  .exp__cta { align-self: flex-start; }

  .pos { padding: 1.7rem 1.6rem; display: flex; flex-direction: column; gap: 0.7rem; }
  .pos h3 { margin: 0.3rem 0 0; font-size: 1.2rem; }
  .pos p { margin: 0; color: var(--muted); font-size: 0.96rem; line-height: 1.6; }

  .apply-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.9fr;
    gap: clamp(1.75rem, 4vw, 3.5rem);
    align-items: start;
  }
  .check-list { list-style: none; margin: 1.25rem 0 1.5rem; padding: 0; display: flex; flex-direction: column; gap: 0.9rem; }
  .check-list li { display: flex; gap: 0.75rem; align-items: flex-start; }
  .check-list svg { flex: none; color: var(--c-robot); margin-top: 0.2rem; }
  .check-list span { color: var(--ink-soft); }

  .apply-card { padding: 1.9rem; position: sticky; top: 6rem; }
  .apply-card h3 { margin: 0 0 0.5rem; }
  .apply-card > p { color: var(--muted); margin-bottom: 0.75rem; }
  .apply-steps { margin: 0 0 1.4rem; padding-left: 1.2rem; display: flex; flex-direction: column; gap: 0.5rem; color: var(--ink-soft); }
  .apply-btn { width: 100%; justify-content: center; }
  .apply-email { text-align: center; margin: 0.9rem 0 0; font-size: 0.9rem; color: var(--muted); word-break: break-all; }

  @media (max-width: 820px) {
    .apply-grid { grid-template-columns: 1fr; }
    .apply-card { position: static; }
  }
</style>
