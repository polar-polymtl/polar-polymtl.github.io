---
interface Links {
  scholar?: string;
  linkedin?: string;
  x?: string;
  github?: string;
}
interface Props {
  name: string;
  role: string;
  institution?: string;
  years?: string;
  note?: string;
  email?: string;
  photo?: string;
  links?: Links;
  featured?: boolean;
}
const { name, role, institution, years, note, email, photo, links, featured = false } = Astro.props;

// Monogram fallback when no photo is provided.
const initials = name
  .replace(/,.*$/, '')
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((w) => w[0]?.toUpperCase())
  .join('');

// Deterministic hue from the name so monograms feel varied but stable.
let hash = 0;
for (let i = 0; i < name.length; i++) hash = (hash * 31 + name.charCodeAt(i)) % 360;

// Social icons (inline SVG paths).
const ICONS: Record<keyof Links, { label: string; svg: string }> = {
  scholar: { label: 'Google Scholar', svg: '<path d="M12 2 1 8l11 6 9-4.9V17h2V8L12 2Z"/><path d="M6 12.2V16c0 1.7 2.7 3 6 3s6-1.3 6-3v-3.8l-6 3.3-6-3.3Z"/>' },
  linkedin: { label: 'LinkedIn', svg: '<path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.83v1.64h.05a4.2 4.2 0 0 1 3.78-2.08c4.04 0 4.79 2.66 4.79 6.12V21h-4v-5.44c0-1.3-.02-2.96-1.8-2.96-1.8 0-2.08 1.41-2.08 2.87V21h-4V9Z"/>' },
  x: { label: 'X', svg: '<path d="M18.9 2H22l-7.3 8.34L23.3 22h-6.6l-5.17-6.76L5.6 22H2.5l7.8-8.92L1 2h6.77l4.67 6.18L18.9 2Zm-1.16 18h1.83L7.34 3.9H5.38L17.74 20Z"/>' },
  github: { label: 'GitHub', svg: '<path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.36 1.09 2.94.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.6 9.6 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"/>' },
};
const socialEntries = links
  ? (Object.keys(ICONS) as (keyof Links)[]).filter((k) => links[k]).map((k) => ({ k, href: links[k]!, ...ICONS[k] }))
  : [];
---

<article class:list={['person', 'card', 'reveal', { 'person--featured': featured }]} style={`--hue:${hash}`}>
  <div class="person__avatar" aria-hidden={photo ? 'true' : undefined}>
    {photo ? <img src={photo} alt={name} loading="lazy" width="180" height="180" /> : <span>{initials}</span>}
  </div>
  <div class="person__body">
    <h3 class="person__name">{name}</h3>
    <p class="person__role">{role}</p>
    {institution && <p class="person__inst">{institution}</p>}
    {note && <p class="person__note">{note}</p>}
    <div class="person__meta">
      {years && <span class="person__years">{years}</span>}
      {email && <a class="person__email" href={`mailto:${email}`}>{email}</a>}
    </div>
    {socialEntries.length > 0 && (
      <div class="person__links">
        {socialEntries.map((s) => (
          <a href={s.href} class="person__link" target="_blank" rel="noopener" aria-label={`${name} on ${s.label}`}>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true" set:html={s.svg} />
          </a>
        ))}
      </div>
    )}
  </div>
</article>

<style>
  .person {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    padding: 1.35rem 1.4rem;
  }
  .person__avatar {
    flex: none;
    width: 116px; height: 116px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 2.1rem;
    color: hsl(var(--hue) 55% 34%);
    background: hsl(var(--hue) 60% 94%);
    overflow: hidden;
  }
  .person__avatar img { width: 100%; height: 100%; object-fit: cover; }
  .person__body { min-width: 0; padding-top: 0.15rem; }
  .person__name { font-size: 1.08rem; margin: 0 0 0.15rem; }
  .person__role { margin: 0; color: var(--ink-soft); font-size: 0.92rem; line-height: 1.4; }
  .person__inst { margin: 0.3rem 0 0; color: var(--muted); font-size: 0.86rem; }
  .person__note {
    margin: 0.55rem 0 0;
    font-size: 0.82rem;
    color: var(--brand-600);
    background: var(--brand-tint);
    padding: 0.35rem 0.6rem;
    border-radius: 8px;
    display: inline-block;
  }
  .person__meta { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; align-items: center; margin-top: 0.55rem; }
  .person__years {
    font-family: var(--font-head);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--muted);
  }
  .person__email { font-size: 0.82rem; word-break: break-all; }

  .person__links { display: flex; gap: 0.5rem; margin-top: 0.7rem; }
  .person__link {
    display: inline-flex; align-items: center; justify-content: center;
    width: 30px; height: 30px;
    border-radius: 8px;
    color: var(--muted);
    background: var(--bg-soft);
    border: 1px solid var(--line);
    transition: color 0.16s var(--ease), background 0.16s var(--ease), transform 0.16s var(--ease);
  }
  .person__link:hover { color: #fff; background: var(--brand-500); border-color: var(--brand-500); transform: translateY(-2px); }

  /* Featured (director) */
  .person--featured {
    flex-direction: column;
    align-items: flex-start;
    gap: 1.2rem;
    padding: 2rem;
    background: linear-gradient(160deg, var(--brand-tint), #fff 60%);
    border-color: var(--brand-400);
  }
  .person--featured .person__avatar {
    width: 164px; height: 164px;
    font-size: 3rem;
    color: #fff;
    background: linear-gradient(150deg, var(--brand), var(--brand-500));
  }
  .person--featured .person__name { font-size: 1.4rem; }
  .person--featured .person__role { font-size: 1rem; color: var(--ink); }
</style>
