---
import Logo from './Logo.astro';
import { useTranslations, localizePath, type Lang } from '../i18n/ui';
const { lang = 'en' } = Astro.props as { lang?: Lang };
const t = useTranslations(lang);
const year = new Date().getFullYear();
const links = [
  { key: 'nav.research', href: '/research/' },
  { key: 'nav.people', href: '/people/' },
  { key: 'nav.opportunities', href: '/opportunities/' },
  { key: 'nav.about', href: '/about/' },
] as const;
---

<footer class="site-footer">
  <div class="container container--wide footer-grid">
    <div class="footer-brand">
      <Logo variant="full" tone="light" />
      <p class="footer-tagline">{t('footer.tagline')}</p>
      <div class="footer-social" aria-label="Social media">
        <a href="https://x.com" class="social" aria-label="POLAR on X" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M18.9 2H22l-7.3 8.34L23.3 22h-6.6l-5.17-6.76L5.6 22H2.5l7.8-8.92L1 2h6.77l4.67 6.18L18.9 2Zm-1.16 18h1.83L7.34 3.9H5.38L17.74 20Z"/></svg>
        </a>
        <a href="https://www.linkedin.com" class="social" aria-label="POLAR on LinkedIn" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.83v1.64h.05a4.2 4.2 0 0 1 3.78-2.08c4.04 0 4.79 2.66 4.79 6.12V21h-4v-5.44c0-1.3-.02-2.96-1.8-2.96-1.8 0-2.08 1.41-2.08 2.87V21h-4V9Z"/></svg>
        </a>
        <a href="https://www.instagram.com" class="social" aria-label="POLAR on Instagram" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 2.2c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.21 15.58 2.2 15.2 2.2 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.21 8.8 2.2 12 2.2Zm0 1.8c-3.14 0-3.51.01-4.75.07-.9.04-1.38.19-1.7.32-.43.16-.74.36-1.06.68-.32.32-.52.63-.68 1.06-.13.32-.28.8-.32 1.7C3.21 8.49 3.2 8.86 3.2 12s.01 3.51.07 4.75c.04.9.19 1.38.32 1.7.16.43.36.74.68 1.06.32.32.63.52 1.06.68.32.13.8.28 1.7.32 1.24.06 1.61.07 4.75.07s3.51-.01 4.75-.07c.9-.04 1.38-.19 1.7-.32.43-.16.74-.36 1.06-.68.32-.32.52-.63.68-1.06.13-.32.28-.8.32-1.7.06-1.24.07-1.61.07-4.75s-.01-3.51-.07-4.75c-.04-.9-.19-1.38-.32-1.7a2.85 2.85 0 0 0-.68-1.06 2.85 2.85 0 0 0-1.06-.68c-.32-.13-.8-.28-1.7-.32C15.51 4.01 15.14 4 12 4Zm0 3.06A4.94 4.94 0 1 1 12 17a4.94 4.94 0 0 1 0-9.88Zm0 1.8a3.14 3.14 0 1 0 0 6.28 3.14 3.14 0 0 0 0-6.28Zm5.14-.9a1.15 1.15 0 1 1 0 2.3 1.15 1.15 0 0 1 0-2.3Z"/></svg>
        </a>
      </div>
    </div>

    <div class="footer-col">
      <h4 class="footer-heading">{t('footer.explore')}</h4>
      <ul class="footer-links">
        {links.map((l) => <li><a href={localizePath(l.href, lang)}>{t(l.key)}</a></li>)}
      </ul>
    </div>

    <div class="footer-col">
      <h4 class="footer-heading">{t('footer.contact')}</h4>
      <ul class="footer-links">
        <li><a href="mailto:POLAR@polymtl.ca">POLAR@polymtl.ca</a></li>
        <li><a href="tel:+15143404711,3939">(514) 340-4711 ext. 3939</a></li>
      </ul>
      <address class="footer-address">
        Pavillon principal, A630.5<br />
        Polytechnique Montréal<br />
        2900 Édouard-Montpetit Blvd<br />
        Montréal, QC, Canada
      </address>
    </div>

    <div class="footer-col">
      <h4 class="footer-heading">{t('footer.affiliations')}</h4>
      <ul class="footer-links footer-links--muted">
        <li>Polytechnique Montréal</li>
        <li>Université de Montréal</li>
        <li>CHU Sainte-Justine</li>
        <li>TransMedTech Institute</li>
      </ul>
    </div>
  </div>

  <div class="container container--wide footer-bottom">
    <p>© {year} POLAR Lab · Polytechnique Montréal. {t('footer.rights')}</p>
    <p>{t('footer.directed')}</p>
  </div>
</footer>

<style>
  .site-footer {
    background: linear-gradient(180deg, #0d1b30, #0a1526);
    color: #c3d0e2;
    padding-block: clamp(3rem, 5vw, 4.5rem) 1.75rem;
    margin-top: auto;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1.3fr 1.1fr;
    gap: clamp(1.75rem, 4vw, 3rem);
    padding-bottom: 2.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .footer-tagline {
    margin-top: 1.1rem;
    max-width: 34ch;
    color: #9fb1c9;
    font-size: 0.96rem;
    line-height: 1.6;
  }
  .footer-social { display: flex; gap: 0.6rem; margin-top: 1.25rem; }
  .social {
    display: inline-flex;
    align-items: center; justify-content: center;
    width: 38px; height: 38px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.08);
    color: #dbe6f5;
    transition: background 0.18s var(--ease), color 0.18s var(--ease), transform 0.18s var(--ease);
  }
  .social:hover { background: var(--brand-500); color: #fff; transform: translateY(-2px); }

  .footer-heading {
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #7d90ab;
    margin-bottom: 1rem;
  }
  .footer-links { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.6rem; }
  .footer-links a { color: #c3d0e2; font-size: 0.96rem; }
  .footer-links a:hover { color: #fff; }
  .footer-links--muted li { color: #9fb1c9; font-size: 0.96rem; }
  .footer-address { font-style: normal; color: #9fb1c9; font-size: 0.92rem; line-height: 1.7; margin-top: 1rem; }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-top: 1.5rem;
    color: #7d90ab;
    font-size: 0.86rem;
  }
  .footer-bottom p { margin: 0; }

  @media (max-width: 860px) {
    .footer-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 520px) {
    .footer-grid { grid-template-columns: 1fr; }
  }
</style>
